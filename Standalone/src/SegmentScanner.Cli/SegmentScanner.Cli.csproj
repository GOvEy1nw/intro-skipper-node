<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>segmentscanner</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../SegmentScanner.Engine/SegmentScanner.Engine.csproj" />
    <Content Include="../../inference/*.py" Link="inference/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../samples/*.json" Link="samples/%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../schemas/*.json" Link="schemas/%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../models/manifests/*.json" Link="models/manifests/%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../inference/requirements.lock" Link="inference/requirements.lock" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../docs/*.md" Link="docs/%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../packaging/windows/*.ps1" Link="packaging/windows/%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../../LICENSE" Link="LICENSE" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../README.md;../../UPSTREAM_CHANGES.md;../../upstream-lock.json" Link="%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
